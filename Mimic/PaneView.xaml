<UserControl
    x:Class="Mimic.PaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mimic">
  <Grid x:Name="PaneRoot" Padding="0,25,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel x:Name="Intro" Padding="2,0,2,18">
      <TextBlock Text="A SMALL STUDIO FOR THINGS WORTH KEEPING" FontSize="10" FontWeight="Bold" CharacterSpacing="170"
                 LineHeight="15.5" Foreground="{ThemeResource RedDeepBrush}" />
      <TextBlock x:Name="IntroHeading" FontFamily="{StaticResource Serif}" FontSize="38" CharacterSpacing="-45"
                 LineStackingStrategy="BlockLineHeight" Margin="0,8,0,0" Foreground="{ThemeResource InkBrush}">
        <Run Text="Listen closely." /><LineBreak /><Run Text="Keep what matters." FontStyle="Italic" Foreground="{ThemeResource RedBrush}" />
      </TextBlock>
      <TextBlock Text="Turn a video into a thoughtful, timestamped archive. Or bring in an image and uncover how it might have been made."
                 FontSize="13" LineHeight="20" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left"
                 Margin="0,10,0,0" Foreground="{ThemeResource MutedBrush}" />
    </StackPanel>

    <!-- Entry card -->
    <Grid Grid.Row="1">
      <Canvas x:Name="EntryShadowHost" />
      <Rectangle x:Name="EntryBg" RadiusX="11" RadiusY="11" Fill="{ThemeResource CardBrush}"
                 Stroke="{StaticResource InkLine11Brush}" StrokeThickness="1" />
      <StackPanel x:Name="Entry" Padding="19" Spacing="12">
        <Grid>
          <TextBlock x:Name="EntryLabel" Text="VIDEO SOURCE" FontSize="10" FontWeight="Bold" CharacterSpacing="20"
                     LineHeight="15.5" Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" />
          <TextBlock x:Name="SourceState" Text="Whisper handles every transcription" FontSize="10" CharacterSpacing="20"
                     LineHeight="15.5"
                     HorizontalAlignment="Right" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
        </Grid>

        <local:FlexWrapPanel Gap="8">
          <TextBox x:Name="Url" IsTabStop="False" local:FlexWrapPanel.Grow="1" local:FlexWrapPanel.Basis="300" Height="62"
                   AcceptsReturn="True" TextWrapping="Wrap" IsSpellCheckEnabled="False" Padding="13,8" CornerRadius="0"
                   FontFamily="Consolas" FontSize="13.333" PreviewKeyDown="OnUrlKeyDown"
                   PlaceholderText="Paste a link · Drop a local video or picture&#x0a;Click Embedded to point at a website video">
            <TextBox.Resources>
              <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                  <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TextControlBackground" Color="#F8F5EE" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#F8F5EE" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#F8F5EE" />
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#F8F5EE" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#767676" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#767676" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#101010" />
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#767676" />
                    <SolidColorBrush x:Key="TextControlForeground" Color="#1D2143" />
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#1D2143" />
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#1D2143" />
                    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#1D2143" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#9693A0" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#9693A0" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#9693A0" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#9693A0" />
                  </ResourceDictionary>
                  <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TextControlBackground" Color="#2B2D41" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2B2D41" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2B2D41" />
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#2B2D41" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#858585" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#858585" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#858585" />
                    <SolidColorBrush x:Key="TextControlForeground" Color="#F0EBDF" />
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F0EBDF" />
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F0EBDF" />
                    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#F0EBDF" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#9693A0" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#9693A0" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#9693A0" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#9693A0" />
                  </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
              </ResourceDictionary>
            </TextBox.Resources>
          </TextBox>
          <local:FlatButton x:Name="Go" Content="Transcribe" Click="OnGo" MinHeight="42" Padding="15,9" CornerRadius="5"
                            FontWeight="SemiBold" BgKey="Red" FgKey="#FFFFFF" HoverBgKey="RedDeep" />
          <local:FlatButton x:Name="EmbeddedButton" Content="Embedded" Click="OnEmbedded" MinHeight="42" Padding="15,9"
                            CornerRadius="5" FontWeight="SemiBold" BgKey="QuietSurface" BorderKey="Line"
                            FgKey="Ink" ToolTipService.ToolTip="Point at a video on your screen, link or no link" />
          <local:FlatButton x:Name="BrowseImage" Content="Browse image…" Click="OnBrowseImage" MinHeight="42" Padding="15,9"
                            CornerRadius="5" FontWeight="SemiBold" BgKey="QuietSurface" BorderKey="Line" FgKey="Ink" />
          <local:FlatButton x:Name="Finish" Content="Finish" Click="OnFinish" Visibility="Collapsed" MinHeight="42"
                            Padding="15,9" CornerRadius="5" FontWeight="SemiBold" BgKey="Red" FgKey="#FFFFFF" HoverBgKey="RedDeep" />
          <local:FlatButton x:Name="Cancel" Content="Cancel" Click="OnCancel" Visibility="Collapsed" MinHeight="42"
                            Padding="15,9" CornerRadius="5" FontWeight="SemiBold" BgKey="#FFF8F5" BorderKey="#C27C75" FgKey="RedDeep" />
        </local:FlexWrapPanel>

        <StackPanel x:Name="LocalCopyOption" Orientation="Horizontal" Spacing="8" Margin="0,9,0,2" Background="Transparent"
                    HorizontalAlignment="Left" Tapped="OnLocalCopyTapped">
          <Grid Width="16" Height="16" VerticalAlignment="Center">
            <Canvas x:Name="CheckGlowHost" />
            <Rectangle x:Name="CheckBoxShape" RadiusX="4" RadiusY="4" StrokeThickness="1"
                       Fill="{ThemeResource PaperDeepBrush}" Stroke="{ThemeResource MutedBrush}" />
            <Path x:Name="CheckMark" Data="M4,8 L7,11 L12,5" Stroke="#1D2143" StrokeThickness="2" Visibility="Collapsed" />
          </Grid>
          <TextBlock x:Name="LocalCopyText" Text="Save a local video copy for playback (takes longer)" FontSize="11"
                     LineHeight="17.05" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <Grid x:Name="JobProgress" Height="5" Margin="0,1,0,0" Visibility="Collapsed">
          <Rectangle RadiusX="2.5" RadiusY="2.5" Fill="{ThemeResource ProgressTrackBrush}" />
          <Rectangle x:Name="JobProgressBar" RadiusX="2.5" RadiusY="2.5" Fill="{StaticResource NavyBrush}"
                     HorizontalAlignment="Left">
            <Rectangle.RenderTransform>
              <TranslateTransform x:Name="JobProgressShift" />
            </Rectangle.RenderTransform>
          </Rectangle>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="7">
          <TextBlock Text="✳" FontFamily="Segoe UI Symbol" FontSize="13" LineHeight="20.15" Foreground="{ThemeResource BlueBrush}" VerticalAlignment="Center" />
          <TextBlock x:Name="EntryNote" FontSize="11" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Text="Drop a video or picture anywhere in Mimic to process it. Two captures can run side by side; notes stay in your local library." />
        </StackPanel>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" MinHeight="26" Margin="2,10,2,0">
      <TextBlock x:Name="Status" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                 Foreground="{ThemeResource MutedBrush}" IsTextSelectionEnabled="True" />
    </Grid>
    <TextBlock x:Name="Stopwatch" Grid.Row="3" Text="00:00" HorizontalAlignment="Right" Margin="2,0,2,9"
               FontFamily="{StaticResource Serif}" FontSize="22" LineHeight="26.4" Foreground="{ThemeResource InkBrush}" />

    <!-- Transcript -->
    <Grid x:Name="Transcript" Grid.Row="4" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel x:Name="TranscriptHeader" Padding="2,4,2,14">
        <Grid x:Name="TitleRow" ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Title" FontFamily="{StaticResource Serif}" FontSize="30" CharacterSpacing="-30"
                     TextWrapping="Wrap" Margin="0,2,0,5" Foreground="{ThemeResource RedBrush}"
                     IsTextSelectionEnabled="True" />
          <local:FlatButton x:Name="TitleEdit" Grid.Column="1" Content="Edit title" Click="OnTitleEdit" Margin="0,4,0,0"
                            VerticalAlignment="Top" BgKey="Green" BorderKey="Green" FgKey="#1D2143" HoverBgKey="GreenHover" />
          <TextBox x:Name="TitleEditor" Visibility="Collapsed" MaxLength="240" Padding="7,3,7,6" CornerRadius="5"
                   FontFamily="{StaticResource Serif}" FontSize="28" MinWidth="180" KeyDown="OnTitleEditorKeyDown"
                   Background="{ThemeResource QuietSurfaceBrush}" BorderBrush="{ThemeResource LineBrush}"
                   Foreground="{ThemeResource RedBrush}" />
          <local:FlatButton x:Name="TitleSave" Grid.Column="1" Content="Save" Click="OnTitleSave" Visibility="Collapsed"
                            VerticalAlignment="Center" BgKey="#8CFFFDF8" BorderKey="Line" FgKey="Ink" HoverBgKey="Card"
                            HoverBorderKey="#B8AD9B" />
          <local:FlatButton x:Name="TitleCancel" Grid.Column="2" Content="Cancel" Click="OnTitleCancel" Visibility="Collapsed"
                            VerticalAlignment="Center" BgKey="#8CFFFDF8" BorderKey="Line" FgKey="Ink" HoverBgKey="Card"
                            HoverBorderKey="#B8AD9B" />
        </Grid>
        <TextBlock x:Name="Meta" FontSize="12" LineHeight="22" TextWrapping="Wrap" Margin="0,0,0,0"
                   Foreground="{ThemeResource MutedBrush}" IsTextSelectionEnabled="True" />
        <local:FlexWrapPanel x:Name="Actions" Gap="6" Margin="0,9,0,0" />
      </StackPanel>
      <ScrollViewer x:Name="PassageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Padding="2,0,15,10">
        <StackPanel x:Name="PassageList" />
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
